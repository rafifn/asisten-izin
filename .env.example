# Copy to .env (never commit .env). Works as-is for fake mode: no API key, no model download.
DATABASE_URL=postgresql://asisten:asisten@127.0.0.1:5433/asisten_izin

# fake = canned LLM answers and hash-based embeddings (for trying the app and for tests).
# For real answers set LLM_MODE=real and EMBEDDER=bge, pick LLM_PROVIDER and set its key
# (see README). Never leave a key line set but empty.
LLM_MODE=fake
EMBEDDER=fake

# Which model answers in real mode: deepseek (default, cheap) or claude.
LLM_PROVIDER=deepseek
# DeepSeek: key from https://platform.deepseek.com ; model defaults to deepseek-flash.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-flash
# Claude: either uncomment ANTHROPIC_API_KEY, or leave it commented out and use an
# `ant auth login` profile (an empty key line would override the profile).
# ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated browser origins allowed to call the API (the web app's URL).
CORS_ORIGINS=http://localhost:3000
