# Copy to .env (never commit .env). Works as-is for fake mode: no API key, no model download.
DATABASE_URL=postgresql://asisten:asisten@127.0.0.1:5433/asisten_izin

# fake = canned LLM answers and hash-based embeddings (for trying the app and for tests).
# For real answers set LLM_MODE=real and EMBEDDER=bge, and authenticate (see README): either
# uncomment ANTHROPIC_API_KEY below, or leave it commented out and use an `ant auth login`
# profile. Never leave it set but empty: an empty key overrides the profile.
LLM_MODE=fake
EMBEDDER=fake
# ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated browser origins allowed to call the API (the web app's URL).
CORS_ORIGINS=http://localhost:3000
